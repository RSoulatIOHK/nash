module ShiftByteString exposing (..)


import Builtin


operation p0 p1 = Builtin.shiftByteString p0 p1


proof
    import Proof

    prop "zero shift is identity" =
        let
            x via Proof.bytes
        in
            do
                assert (operation x 0 == x)

    test "direction and zero fill" =
        do
            assert (operation #"01" 1 == #"02" && operation #"80" (-1) == #"40")

    prop "shifting out every bit produces zero" =
        let
            x via Proof.bytes
        in
            do
                assert
                    (
                        Builtin.countSetBits
                            (
                                operation
                                    x
                                    (
                                        Builtin.multiplyInteger
                                            8
                                            (Builtin.lengthOfByteString x)
                                    )
                            ) ==
                            0
                    )

    test "large shift does not truncate to a host word" =
        do
            assert
                (
                    Builtin.countSetBits
                        (
                            operation
                                #"ff"
                                (
                                    Builtin.byteStringToInteger
                                        True
                                        #"0100000000000000000000000000000000"
                                )
                        ) ==
                        0
                )

    test "whole byte shifts preserve the remaining bytes" =
        do
            assert
                (
                    operation #"001122" 8 ==
                        #"112200" &&
                        operation #"001122" (-8) ==
                        #"000011"
                )
