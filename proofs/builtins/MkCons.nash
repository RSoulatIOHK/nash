module MkCons exposing (..)


import Builtin


operation p0 p1 = Builtin.mkCons p0 p1


proof
    import Proof

    prop "head of cons is its element" =
        let
            x via Proof.data
            y via Proof.data
        in
            do
                assert (Builtin.headList (operation x [ y ]) == x)

    prop "tail of cons is its original list" =
        let
            x via Proof.data
            y via Proof.data
        in
            do
                assert
                    (
                        Builtin.headList (Builtin.tailList (operation x [ y ])) ==
                            y &&
                            Builtin.nullList
                                (
                                    Builtin.tailList
                                        (Builtin.tailList (operation x [ y ]))
                                )
                    )

    prop "cons is never empty" =
        let
            x via Proof.data
        in
            do
                assert (not (Builtin.nullList (operation x [])))
