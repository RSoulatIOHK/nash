module ComplementByteString exposing (..)


import Builtin


operation p0 = Builtin.complementByteString p0


proof
    import Proof

    prop "involution" =
        let
            x via Proof.bytes
        in
            do
                assert (operation (operation x) == x)

    prop "preserves length" =
        let
            x via Proof.bytes
        in
            do
                assert
                    (
                        Builtin.lengthOfByteString (operation x) ==
                            Builtin.lengthOfByteString x
                    )

    test "complements every bit" =
        do
            assert (operation #"00ff0f" == #"ff00f0")
