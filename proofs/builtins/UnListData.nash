module UnListData exposing (..)


import Builtin


operation p0 = Builtin.unListData p0


wrongShape : int -> List Data
wrongShape x = Primitive.coerce (Builtin.iData x)


wrongBytes : bytes -> List Data
wrongBytes x = Primitive.coerce (Builtin.bData x)


proof
    import Proof

    prop "recovers the first element" =
        let
            x via Proof.data
        in
            do
                assert
                    (Builtin.headList (operation (Builtin.listData [ x ])) == x)

    prop "integer Data is not list Data" fail =
        let
            x via Proof.int
        in
            do
                let
                    _ = operation (wrongShape x)
                in
                    ()

    prop "bytes Data cannot be used as a list" fail =
        let
            x via Proof.bytes
        in
            do
                let
                    _ = operation (wrongBytes x)
                in
                    ()
