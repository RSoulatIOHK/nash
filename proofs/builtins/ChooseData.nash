module ChooseData exposing (..)


import Builtin


operation p0 p1 p2 p3 p4 p5 = Builtin.chooseData p0 p1 p2 p3 p4 p5


emptyMap : Map Data Data
emptyMap = Builtin.mapData []


emptyList : List Data
emptyList = Builtin.listData []


proof
    import Proof

    test "selects the constructor branch" =
        do
            assert (operation (Builtin.constrData 0 []) 10 20 30 40 50 == 10)

    test "selects the map branch" =
        do
            assert (operation (Primitive.coerce emptyMap) 10 20 30 40 50 == 20)

    test "selects the list branch" =
        do
            assert (operation (Primitive.coerce emptyList) 10 20 30 40 50 == 30)

    prop "selects the integer branch" =
        let
            x via Proof.int
        in
            do
                assert
                    (
                        operation
                            (Primitive.coerce (Builtin.iData x))
                            10
                            20
                            30
                            40
                            50 ==
                            40
                    )

    prop "selects the bytes branch" =
        let
            x via Proof.bytes
        in
            do
                assert
                    (
                        operation
                            (Primitive.coerce (Builtin.bData x))
                            10
                            20
                            30
                            40
                            50 ==
                            50
                    )
