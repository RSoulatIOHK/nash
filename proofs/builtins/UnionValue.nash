module UnionValue exposing (..)


import Builtin
import Cardano.Value


{-| The pinned PlutusCoreBlaster revision has no array/value model. These are
executable source obligations; Lean verification is pending model support. -}
operation p0 p1 = Builtin.unionValue p0 p1


empty : value
empty = Cardano.Value.empty


coin : int -> value
coin amount = Builtin.insertCoin #"" #"" amount empty


proof
    test "empty value is the identity" =
        do
            assert (Builtin.lookupCoin #"" #"" (operation empty (coin 5)) == 5)

    test "adds the same asset quantities" =
        do
            assert
                (Builtin.lookupCoin #"" #"" (operation (coin 5) (coin 7)) == 12)

    test "quantity overflow rejects" fail =
        do
            let
                _ =
                    operation
                        (coin 170141183460469231731687303715884105727)
                        (coin 1)
            in
                ()
