module Trace exposing (..)


import Builtin


{-| The returned value is specified here. Log contents are not observed by the proof backend. -}
operation p0 p1 = Builtin.trace p0 p1


proof
    import Proof

    prop "preserves the value" =
        let
            message via Proof.string
            x via Proof.data
        in
            do
                assert (operation message x == x)

    test "detects wrong opcode argument order or signedness" =
        do
            assert (operation "log" 17 == 17)
