module UnBData exposing (..)


import Builtin


operation p0 = Builtin.unBData p0


proof
    import Proof

    prop "unboxes every bytestring" =
        let
            x via Proof.bytes
        in
            do
                assert (operation (Builtin.bData x) == x)

    prop "integer Data is not bytes Data" fail =
        let
            x via Proof.int
        in
            do
                let
                    _ = operation (Primitive.coerce (Builtin.iData x))
                in
                    ()

    test "constructor Data cannot be used as bytes" fail =
        do
            let
                _ = operation (Primitive.coerce (Builtin.constrData 0 []))
            in
                ()
