module Bls12381FinalVerify exposing (..)


import Builtin


{-| Pairing consistency is pending opaque cryptographic model contracts. -}
operation p0 p1 = Builtin.bls12_381_finalVerify p0 p1


g1 : bytes -> bls_g1
g1 encoded = Builtin.bls12_381_g1_uncompress encoded


g2 : bytes -> bls_g2
g2 encoded = Builtin.bls12_381_g2_uncompress encoded


ml : bytes -> bytes -> bls_mlr
ml x y = Builtin.bls12_381_millerLoop (g1 x) (g2 y)


proof
    import Proof

    prop "reflexive on valid Miller loop results" =
        let
            x via Proof.bytes
            y via Proof.bytes
        in
            do
                Proof.returns (operation (ml x y) (ml x y)) (\holds -> holds)
