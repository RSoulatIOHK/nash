module Bls12381G1Equal exposing (..)


import Builtin


{-| These group laws are partial correctness over successfully decoded points. They do not assert that arbitrary bytes decode to a valid point. The pinned Lean model has opaque group operations without algebraic lemmas; these obligations are pending there. -}
operation p0 p1 = Builtin.bls12_381_g1_equal p0 p1


point : bytes -> bls_g1
point encoded = Builtin.bls12_381_g1_uncompress encoded


proof
    import Proof

    prop "reflexive on valid points" =
        let
            x via Proof.bytes
        in
            do
                Proof.returns (operation (point x) (point x)) (\holds -> holds)
