module ListData exposing (..)


import Builtin


operation p0 = Builtin.listData p0


proof
    import Proof

    prop "list elements survive roundtrip" =
        let
            x via Proof.data
            y via Proof.data
        in
            do
                assert
                    (
                        Builtin.headList
                            (Builtin.unListData (operation [ x, y ])) ==
                            x &&
                            Builtin.headList
                                (
                                    Builtin.tailList
                                        (
                                            Builtin.unListData
                                                (operation [ x, y ])
                                        )
                                ) ==
                            y
                    )
