module Bls12381MulMlResult exposing (..)


import Builtin


{-| Pairing algebra is pending opaque cryptographic model contracts. -}
operation p0 p1 = Builtin.bls12_381_mulMlResult p0 p1


g1 : bytes -> bls_g1
g1 encoded = Builtin.bls12_381_g1_uncompress encoded


g2 : bytes -> bls_g2
g2 encoded = Builtin.bls12_381_g2_uncompress encoded


ml : bytes -> bytes -> bls_mlr
ml x y = Builtin.bls12_381_millerLoop (g1 x) (g2 y)


proof
    import Proof

    prop "commutative under final verification" =
        let
            leftG1 via Proof.bytes
            leftG2 via Proof.bytes
            rightG1 via Proof.bytes
            rightG2 via Proof.bytes
        in
            do
                Proof.returns
                    (
                        Builtin.bls12_381_finalVerify
                            (operation (ml leftG1 leftG2) (ml rightG1 rightG2))
                            (operation (ml rightG1 rightG2) (ml leftG1 leftG2))
                    )
                    (\holds -> holds)
