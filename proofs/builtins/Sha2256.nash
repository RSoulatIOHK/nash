module Sha2256 exposing (..)


import Builtin


{-| Digest length is the semantic obligation here. This does not claim collision resistance or correctness of the underlying cryptographic implementation. The pinned Lean model exposes an opaque hash without length lemmas; this obligation is pending there. -}
operation p0 = Builtin.sha2_256 p0


proof
    import Proof

    prop "digest has the specified byte length" =
        let
            message via Proof.bytes
        in
            do
                assert (Builtin.lengthOfByteString (operation message) == 32)

    test "empty message known answer detects the wrong hash primitive" =
        do
            assert
                (
                    operation #"" ==
                        #"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
                )
