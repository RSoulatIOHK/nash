module LessThanEqualsByteString exposing (..)


import Builtin


operation p0 p1 = Builtin.lessThanEqualsByteString p0 p1


proof
    import Proof

    prop "reflexive" =
        let
            x via Proof.bytes
        in
            do
                assert (operation x x)

    prop "agrees with strict order or equality" =
        let
            x via Proof.bytes
            y via Proof.bytes
        in
            do
                assert
                    (
                        operation x y ==
                            (
                                Builtin.lessThanByteString x y ||
                                    Builtin.equalsByteString x y
                            )
                    )
