module SliceByteString exposing (..)


import Builtin


operation p0 p1 p2 = Builtin.sliceByteString p0 p1 p2


proof
    import Proof

    prop "zero count produces empty bytes" =
        let
            x via Proof.bytes
            offset via Proof.int
        in
            do
                assert (operation offset 0 x == #"")

    prop "negative count produces empty bytes" =
        let
            x via Proof.bytes
        in
            do
                assert (operation 0 (-1) x == #"")

    prop "whole slice preserves the bytes" =
        let
            x via Proof.bytes
        in
            do
                assert (operation 0 (Builtin.lengthOfByteString x) x == x)

    test "negative offset is clamped independently of count" =
        do
            assert (operation (-2) 2 #"010203" == #"0102")

    prop "offset at the end gives empty bytes" =
        let
            x via Proof.bytes
        in
            do
                assert (operation (Builtin.lengthOfByteString x) 1 x == #"")

    test "detects wrong opcode argument order or signedness" =
        do
            assert (operation 1 2 #"00010203" == #"0102")
