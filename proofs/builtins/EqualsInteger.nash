module EqualsInteger exposing (..)


import Builtin


operation p0 p1 = Builtin.equalsInteger p0 p1


proof
    import Proof

    prop "reflexive" =
        let
            x via Proof.int
        in
            do
                assert (operation x x)

    prop "symmetric" =
        let
            x via Proof.int
            y via Proof.int
        in
            do
                assert (operation x y == operation y x)

    prop "equivalent to zero difference" =
        let
            x via Proof.int
            y via Proof.int
        in
            do
                assert
                    (
                        operation x y ==
                            Builtin.equalsInteger
                                (Builtin.subtractInteger x y)
                                0
                    )

    prop "successive integers are distinct at every width" =
        let
            x via Proof.int
        in
            do
                assert (not (operation x (Builtin.addInteger x 1)))

    test "detects wrong opcode argument order or signedness" =
        do
            assert (not (operation (-1) 1))
