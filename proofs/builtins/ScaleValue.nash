module ScaleValue exposing (..)


import Builtin
import Cardano.Value


{-| The pinned PlutusCoreBlaster revision has no array/value model. These are
executable source obligations; Lean verification is pending model support. -}
operation p0 p1 = Builtin.scaleValue p0 p1


empty : value
empty = Cardano.Value.empty


coin : int -> value
coin amount = Builtin.insertCoin #"" #"" amount empty


proof
    test "zero annihilates quantities" =
        do
            assert (Builtin.lookupCoin #"" #"" (operation 0 (coin 5)) == 0)

    test "multiplicative identity" =
        do
            assert (Builtin.lookupCoin #"" #"" (operation 1 (coin 5)) == 5)

    test "scales quantities" =
        do
            assert (Builtin.lookupCoin #"" #"" (operation 3 (coin 5)) == 15)

    test "quantity overflow rejects" fail =
        do
            let
                _ = operation 2 (coin 170141183460469231731687303715884105727)
            in
                ()

    test "out of bounds multiplier rejects" fail =
        do
            let
                _ =
                    operation
                        (
                            Builtin.byteStringToInteger
                                True
                                #"80000000000000000000000000000000"
                        )
                        empty
            in
                ()
