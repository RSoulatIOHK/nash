module DropList exposing (..)


import Builtin


operation p0 p1 = Builtin.dropList p0 p1


proof
    import Proof

    prop "dropping zero preserves the head" =
        let
            x via Proof.data
        in
            do
                assert (Builtin.headList (operation 0 [ x ]) == x)

    prop "dropping one preserves the next element" =
        let
            x via Proof.data
            y via Proof.data
        in
            do
                assert (Builtin.headList (operation 1 [ x, y ]) == y)

    prop "dropping the full list gives empty" =
        let
            x via Proof.data
            y via Proof.data
        in
            do
                assert (Builtin.nullList (operation 2 [ x, y ]))

    prop "negative count preserves the list" =
        let
            x via Proof.data
        in
            do
                assert (Builtin.headList (operation (-1) [ x ]) == x)

    prop "count beyond length gives empty" =
        let
            x via Proof.data
        in
            do
                assert (Builtin.nullList (operation 1000000 [ x ]))
