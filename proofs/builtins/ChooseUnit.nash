module ChooseUnit exposing (..)


import Builtin


operation p0 p1 = Builtin.chooseUnit p0 p1


proof
    import Proof

    prop "returns the second argument" =
        let
            x via Proof.data
        in
            do
                assert (operation () x == x)

    test "detects wrong opcode argument order or signedness" =
        do
            assert (operation () 17 == 17)
