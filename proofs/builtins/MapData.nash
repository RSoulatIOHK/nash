module MapData exposing (..)


import Builtin


operation p0 = Builtin.mapData p0


proof
    import Proof

    prop "map entry survives roundtrip" =
        let
            x via Proof.data
            y via Proof.data
        in
            do
                assert
                    (
                        Builtin.fstPair
                            (
                                Builtin.headList
                                    (
                                        Builtin.unMapData
                                            (
                                                operation
                                                    [ Builtin.mkPairData x y ]
                                            )
                                    )
                            ) ==
                            x &&
                            Builtin.sndPair
                                (
                                    Builtin.headList
                                        (
                                            Builtin.unMapData
                                                (
                                                    operation
                                                        [ Builtin.mkPairData x y
                                                        ]
                                                )
                                        )
                                ) ==
                            y
                    )
