module AppendString exposing (..)


import Builtin


operation p0 p1 = Builtin.appendString p0 p1


proof
    import Proof

    prop "left and right identity" =
        let
            x via Proof.string
        in
            do
                assert (operation "" x == x && operation x "" == x)

    prop "associative" =
        let
            x via Proof.string
            y via Proof.string
            z via Proof.string
        in
            do
                assert
                    (operation (operation x y) z == operation x (operation y z))

    test "preserves Unicode characters" =
        do
            assert (operation "é" "λ" == "éλ")
