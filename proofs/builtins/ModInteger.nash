module ModInteger exposing (..)


import Builtin


operation p0 p1 = Builtin.modInteger p0 p1


proof
    import Proof

    prop "remainder modulo one is zero" =
        let
            x via Proof.int
        in
            do
                assert (operation x 1 == 0)

    prop "division reconstruction" =
        let
            x via Proof.int
            y via Proof.int
        in
            do
                assert
                    (
                        if y == 0 then
                            True
                        else
                            Builtin.addInteger
                                (
                                    Builtin.multiplyInteger
                                        (Builtin.divideInteger x y)
                                        y
                                )
                                (operation x y) ==
                                x
                    )

    prop "positive modulus bounds the remainder" =
        let
            x via Proof.int
            y via Proof.int
        in
            do
                assert
                    (
                        if y > 0 then
                            operation x y >= 0 && operation x y < y
                        else
                            True
                    )

    test "negative rounding convention" =
        do
            assert (operation (-7) 3 == 2)

    prop "zero divisor rejects every dividend" fail =
        let
            x via Proof.int
        in
            do
                let
                    _ = operation x 0
                in
                    ()

    test "detects wrong opcode argument order or signedness" =
        do
            assert (operation 7 (-3) == -2)
