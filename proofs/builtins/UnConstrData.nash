module UnConstrData exposing (..)


import Builtin


operation p0 = Builtin.unConstrData p0


proof
    import Proof

    prop "recovers tag and first field" =
        let
            tag via Proof.int
            x via Proof.data
        in
            do
                assert
                    (
                        Builtin.fstPair
                            (operation (Builtin.constrData tag [ x ])) ==
                            tag &&
                            Builtin.headList
                                (
                                    Builtin.sndPair
                                        (
                                            operation
                                                (Builtin.constrData tag [ x ])
                                        )
                                ) ==
                            x
                    )

    prop "integer Data is not constructor Data" fail =
        let
            x via Proof.int
        in
            do
                let
                    _ = operation (Primitive.coerce (Builtin.iData x))
                in
                    ()

    prop "bytes Data cannot be used as a constructor" fail =
        let
            x via Proof.bytes
        in
            do
                let
                    _ = operation (Primitive.coerce (Builtin.bData x))
                in
                    ()
