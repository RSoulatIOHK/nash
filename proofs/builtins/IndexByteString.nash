module IndexByteString exposing (..)


import Builtin


operation p0 p1 = Builtin.indexByteString p0 p1


proof
    import Proof

    prop "valid indices return a byte" =
        let
            x via Proof.bytes
            index via Proof.int
        in
            do
                assert
                    (
                        if index >= 0 && index < Builtin.lengthOfByteString x then
                            operation x index >= 0 && operation x index <= 255
                        else
                            True
                    )

    prop "cons supplies index zero" =
        let
            x via Proof.bytes
        in
            do
                assert (operation (Builtin.consByteString 255 x) 0 == 255)

    prop "negative index rejects" fail =
        let
            x via Proof.bytes
        in
            do
                let
                    _ = operation x (-1)
                in
                    ()

    prop "index equal to length rejects" fail =
        let
            x via Proof.bytes
        in
            do
                let
                    _ = operation x (Builtin.lengthOfByteString x)
                in
                    ()

    test "index must not truncate to a machine word" fail =
        do
            let
                _ = operation #"ff" 18446744073709551616
            in
                ()

    test "index above 128 bits rejects without host overflow" fail =
        do
            let
                _ =
                    operation
                        #"ff"
                        (
                            Builtin.byteStringToInteger
                                True
                                #"0100000000000000000000000000000000"
                        )
            in
                ()
