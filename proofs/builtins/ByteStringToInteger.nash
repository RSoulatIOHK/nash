module ByteStringToInteger exposing (..)


import Builtin


operation p0 p1 = Builtin.byteStringToInteger p0 p1


proof
    import Proof

    prop "empty bytes mean zero" =
        let
            bigEndian via Proof.bool
        in
            do
                assert (operation bigEndian #"" == 0)

    test "endianness" =
        do
            assert
                (
                    operation True #"0102" ==
                        258 &&
                        operation False #"0102" ==
                        513
                )

    prop "arbitrary width conversion stays nonnegative" =
        let
            bigEndian via Proof.bool
            x via Proof.bytes
        in
            do
                assert (operation bigEndian x >= 0)

    prop "leading zero does not alter big endian value" =
        let
            x via Proof.bytes
        in
            do
                assert
                    (
                        operation True (Builtin.consByteString 0 x) ==
                            operation True x
                    )
