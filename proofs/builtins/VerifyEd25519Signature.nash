module VerifyEd25519Signature exposing (..)


import Builtin


{-| Malformed-key rejection is specified explicitly. Signature soundness and completeness require cryptographic contracts absent from the pinned model. -}
operation p0 p1 p2 = Builtin.verifyEd25519Signature p0 p1 p2


proof
    import Proof

    prop "empty public key rejects" fail =
        let
            message via Proof.bytes
        in
            do
                let
                    _ = operation #"" message #""
                in
                    ()

    test "valid key with truncated signature rejects" fail =
        do
            let
                _ =
                    operation
                        #"d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
                        #""
                        #"00"
            in
                ()

    test "RFC8032 empty message signature verifies" =
        do
            assert
                (
                    operation
                        #"d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
                        #""
                        #"e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"
                )

    test "changed message returns False instead of rejecting" =
        do
            assert
                (
                    not
                        (
                            operation
                                #"d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
                                #"00"
                                #"e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"
                        )
                )
