module Bls12381G2ScalarMul exposing (..)


import Builtin


{-| These group laws are partial correctness over successfully decoded points. They do not assert that arbitrary bytes decode to a valid point. The pinned Lean model has opaque group operations without algebraic lemmas; these obligations are pending there. -}
operation p0 p1 = Builtin.bls12_381_g2_scalarMul p0 p1


point : bytes -> bls_g2
point encoded = Builtin.bls12_381_g2_uncompress encoded


proof
    import Proof

    prop "scalar one is the identity on valid points" =
        let
            x via Proof.bytes
        in
            do
                Proof.returns
                    (
                        Builtin.bls12_381_g2_equal
                            (operation 1 (point x))
                            (point x)
                    )
                    (\holds -> holds)
