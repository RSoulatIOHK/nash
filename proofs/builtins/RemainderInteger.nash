module RemainderInteger exposing (..)


import Builtin


operation p0 p1 = Builtin.remainderInteger p0 p1


proof
    import Proof

    prop "remainder modulo one is zero" =
        let
            x via Proof.int
        in
            do
                assert (operation x 1 == 0)

    prop "division reconstruction" =
        let
            x via Proof.int
            y via Proof.int
        in
            do
                assert
                    (
                        if y == 0 then
                            True
                        else
                            Builtin.addInteger
                                (
                                    Builtin.multiplyInteger
                                        (Builtin.quotientInteger x y)
                                        y
                                )
                                (operation x y) ==
                                x
                    )

    prop "remainder has the dividend sign" =
        let
            x via Proof.int
            y via Proof.int
        in
            do
                assert
                    (
                        if y == 0 then
                            True
                        else if x >= 0 then
                            operation x y >= 0
                        else
                            operation x y <= 0
                    )

    test "negative rounding convention" =
        do
            assert (operation (-7) 3 == -1)

    prop "zero divisor rejects every dividend" fail =
        let
            x via Proof.int
        in
            do
                let
                    _ = operation x 0
                in
                    ()

    test "detects wrong opcode argument order or signedness" =
        do
            assert (operation 7 (-3) == 1)
