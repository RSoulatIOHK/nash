module ExpModInteger exposing (..)


import Builtin


operation p0 p1 p2 = Builtin.expModInteger p0 p1 p2


proof
    import Proof

    prop "exponent zero gives the modular identity" =
        let
            x via Proof.int
        in
            do
                assert (operation x 0 7 == 1)

    test "known modular power" =
        do
            assert (operation 2 10 7 == 2)

    test "zero modulus rejects" fail =
        do
            let
                _ = operation 2 10 0
            in
                ()

    test "negative modulus rejects" fail =
        do
            let
                _ = operation 2 3 (-7)
            in
                ()

    test "missing modular inverse rejects" fail =
        do
            let
                _ = operation 2 (-1) 4
            in
                ()

    test "negative exponent uses modular inverse" =
        do
            assert (operation 2 (-1) 7 == 4)
