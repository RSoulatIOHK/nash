module Bls12381MillerLoop exposing (..)


import Builtin


{-| Basic pairing consistency, pending opaque cryptographic model contracts. -}
operation p0 p1 = Builtin.bls12_381_millerLoop p0 p1


g1 : bytes -> bls_g1
g1 encoded = Builtin.bls12_381_g1_uncompress encoded


g2 : bytes -> bls_g2
g2 encoded = Builtin.bls12_381_g2_uncompress encoded


proof
    import Proof

    prop "pairing the same points gives equivalent results" =
        let
            x via Proof.bytes
            y via Proof.bytes
        in
            do
                Proof.returns
                    (
                        Builtin.bls12_381_finalVerify
                            (operation (g1 x) (g2 y))
                            (operation (g1 x) (g2 y))
                    )
                    (\holds -> holds)
