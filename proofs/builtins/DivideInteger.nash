module DivideInteger exposing (..)


import Builtin


operation p0 p1 = Builtin.divideInteger p0 p1


proof
    import Proof

    prop "division by one" =
        let
            x via Proof.int
        in
            do
                assert (operation x 1 == x)

    prop "quotient and remainder reconstruct the dividend" =
        let
            x via Proof.int
            y via Proof.int
        in
            do
                assert
                    (
                        if y == 0 then
                            True
                        else
                            Builtin.addInteger
                                (Builtin.multiplyInteger (operation x y) y)
                                (Builtin.modInteger x y) ==
                                x
                    )

    test "negative rounding convention" =
        do
            assert (operation (-7) 3 == -3)

    prop "zero divisor rejects every dividend" fail =
        let
            x via Proof.int
        in
            do
                let
                    _ = operation x 0
                in
                    ()

    test "detects wrong opcode argument order or signedness" =
        do
            assert
                (operation (-9223372036854775808) (-1) == 9223372036854775808)
