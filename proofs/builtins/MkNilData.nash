module MkNilData exposing (..)


import Builtin


operation p0 = Builtin.mkNilData p0


proof
    test "produces the empty list" =
        do
            assert (Builtin.nullList (operation ()))

    test "empty result has no head" fail =
        do
            let
                _ = Builtin.headList (operation ())
            in
                ()
