module IndexArray exposing (..)


import Builtin


{-| The pinned PlutusCoreBlaster revision has no array/value model. These are
executable source obligations; Lean verification is pending model support. -}
operation p0 p1 = Builtin.indexArray p0 p1


one : array int
one = Builtin.listToArray [ 1 ]


proof
    import Proof

    prop "selects each position" =
        let
            x via Proof.data
            y via Proof.data
        in
            do
                assert
                    (
                        operation (Builtin.listToArray [ x, y ]) 0 ==
                            x &&
                            operation (Builtin.listToArray [ x, y ]) 1 ==
                            y
                    )

    test "negative index rejects" fail =
        do
            let
                _ = operation one (-1)
            in
                ()

    test "index equal to length rejects" fail =
        do
            let
                _ = operation one 1
            in
                ()

    test "index must not truncate to a machine word" fail =
        do
            let
                _ = operation one 18446744073709551616
            in
                ()

    test "index above 128 bits rejects without host overflow" fail =
        do
            let
                _ =
                    operation
                        one
                        (
                            Builtin.byteStringToInteger
                                True
                                #"0100000000000000000000000000000000"
                        )
            in
                ()
