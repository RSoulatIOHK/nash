module Bls12381G2HashToGroup exposing (..)


import Builtin


{-| Uses a short fixed domain separation tag. Pending cryptographic contracts in the pinned Lean model. -}
operation p0 p1 = Builtin.bls12_381_g2_hashToGroup p0 p1


proof
    import Proof

    prop "hash to group yields a compressed point of fixed width" =
        let
            message via Proof.bytes
        in
            do
                assert
                    (
                        Builtin.lengthOfByteString
                            (
                                Builtin.bls12_381_g2_compress
                                    (operation message #"4e617368")
                            ) ==
                            96
                    )

    test "oversized domain separator rejects" fail =
        do
            let
                _ = operation #"" (Builtin.replicateByte 256 0)
            in
                ()
