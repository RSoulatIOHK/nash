module UnValueData exposing (..)


import Builtin
import Cardano.Value


{-| The pinned PlutusCoreBlaster revision has no array/value model. These are
executable source obligations; Lean verification is pending model support. -}
operation p0 = Builtin.unValueData p0


empty : value
empty = Cardano.Value.empty


coin : int -> value
coin amount = Builtin.insertCoin #"" #"" amount empty


emptyAssetMap : Map Bytes Int
emptyAssetMap = Builtin.mapData []


emptyInner : Data
emptyInner =
    Primitive.coerce
        (
            Builtin.mapData
                [ Builtin.mkPairData (Builtin.bData #"") emptyAssetMap ]
        )


zeroQuantity : Data
zeroQuantity =
    Primitive.coerce
        (
            Builtin.mapData
                [ Builtin.mkPairData
                    (Builtin.bData #"")
                    (
                        Builtin.mapData
                            [ Builtin.mkPairData
                                (Builtin.bData #"")
                                (Builtin.iData 0)
                            ]
                    )
                ]
        )


duplicateToken : Data
duplicateToken =
    Primitive.coerce
        (
            Builtin.mapData
                [ Builtin.mkPairData
                    (Builtin.bData #"")
                    (
                        Builtin.mapData
                            [ Builtin.mkPairData
                                (Builtin.bData #"")
                                (Builtin.iData 1)
                            , Builtin.mkPairData
                                (Builtin.bData #"")
                                (Builtin.iData 2)
                            ]
                    )
                ]
        )


unsortedTokens : Data
unsortedTokens =
    Primitive.coerce
        (
            Builtin.mapData
                [ Builtin.mkPairData
                    (Builtin.bData #"")
                    (
                        Builtin.mapData
                            [ Builtin.mkPairData
                                (Builtin.bData #"01")
                                (Builtin.iData 1)
                            , Builtin.mkPairData
                                (Builtin.bData #"00")
                                (Builtin.iData 2)
                            ]
                    )
                ]
        )


proof
    test "decoding and encoding recover quantities" =
        do
            assert
                (
                    Builtin.lookupCoin
                        #""
                        #""
                        (operation (Builtin.valueData (coin 5))) ==
                        5
                )

    test "integer Data is not a value" fail =
        do
            let
                _ = operation (Primitive.coerce (Builtin.iData 5))
            in
                ()

    test "empty inner asset map rejects" fail =
        do
            let
                _ = operation emptyInner
            in
                ()

    test "zero encoded quantity rejects" fail =
        do
            let
                _ = operation zeroQuantity
            in
                ()

    test "duplicate asset names reject" fail =
        do
            let
                _ = operation duplicateToken
            in
                ()

    test "out of order asset names reject" fail =
        do
            let
                _ = operation unsortedTokens
            in
                ()
