module ChooseList exposing (..)


import Builtin


operation : list Data -> int -> int -> int
operation p0 p1 p2 = Builtin.chooseList p0 p1 p2


proof
    import Proof

    prop "empty list chooses the empty branch" =
        let
            x via Proof.int
            y via Proof.int
        in
            do
                assert (operation [] x y == x)

    prop "nonempty list chooses the nonempty branch" =
        let
            item via Proof.data
            x via Proof.int
            y via Proof.int
        in
            do
                assert (operation [ item ] x y == y)

    test "detects wrong opcode argument order or signedness" =
        do
            assert
                (
                    operation [] 17 5 ==
                        17 &&
                        operation [ Builtin.constrData 0 [] ] 17 5 ==
                        5
                )
