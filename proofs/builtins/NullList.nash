module NullList exposing (..)


import Builtin


operation : list Data -> bool
operation p0 = Builtin.nullList p0


proof
    import Proof

    test "empty list is null" =
        do
            assert (operation [])

    prop "singleton list is not null" =
        let
            x via Proof.data
        in
            do
                assert (not (operation [ x ]))
