module EqualsString exposing (..)


import Builtin


operation p0 p1 = Builtin.equalsString p0 p1


proof
    import Proof

    prop "reflexive" =
        let
            x via Proof.string
        in
            do
                assert (operation x x)

    prop "symmetric" =
        let
            x via Proof.string
            y via Proof.string
        in
            do
                assert (operation x y == operation y x)

    prop "transitive" =
        let
            x via Proof.string
            y via Proof.string
            z via Proof.string
        in
            do
                assert
                    (
                        if operation x y && operation y z then
                            operation x z
                        else
                            True
                    )

    test "detects wrong opcode argument order or signedness" =
        do
            assert (not (operation "é" "e") && not (operation "a" "ab"))
