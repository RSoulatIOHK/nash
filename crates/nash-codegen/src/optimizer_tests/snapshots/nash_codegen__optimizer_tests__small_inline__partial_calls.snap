(program 1.1.0
  [(lam add_3
    [(lam anf_4
      [(lam anf_5
        [(lam anf_6
          [(lam anf_7
            [(lam anf_8
              [(lam anf_9 [[(builtin addInteger) anf_5] anf_9])
                [[(builtin addInteger) anf_7] anf_8]])
              [[add_3 (con integer 3)] (con integer 4)]])
            [anf_6 (con integer 1)]])
          [add_3 (con integer 20)]])
        [anf_4 (con integer 1)]])
      [add_3 (con integer 10)]])
    (lam x_1 (lam y_2 [[(builtin addInteger) x_1] y_2]))])
