let anf#8 : int = add#3 3 4 in
let anf#9 : int = addInteger anf#7 anf#8 in
addInteger anf#5 anf#9
--- core after
let add#3 : int -> int -> int = \x#1 : int y#2 : int -> addInteger x#1 y#2 in
