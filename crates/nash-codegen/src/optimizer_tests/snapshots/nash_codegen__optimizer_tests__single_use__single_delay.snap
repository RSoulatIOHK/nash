---
--- core before
let d#1 : @delay int = delay (trace "delayed" in 42) in
trace "before force" in force d#1
--- core after
trace "before force" in force (delay (trace "delayed" in 42))
--- baseline
--- uplc
(program 1.1.0
  [(lam d_1
    (force
      [[(force (builtin trace)) (con string "before force")] (delay (force d_1))]))
    (delay
      (force
        [[(force (builtin trace)) (con string "delayed")] (delay (con integer 42))]))])
--- result
(con integer 42)
--- logs
["before force", "delayed"]
--- candidate
--- uplc
(program 1.1.0
  (force
    [[(force (builtin trace)) (con string "before force")]
      (delay
        (force
          (delay
            (force
              [[(force (builtin trace)) (con string "delayed")] (delay (con integer 42))]))))]))
