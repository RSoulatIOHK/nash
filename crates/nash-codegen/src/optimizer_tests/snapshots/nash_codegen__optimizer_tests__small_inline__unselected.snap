--- unoptimized Core
let increment#2 : int -> int = \x#1 : int -> addInteger x#1 1 in
case@Bool true of
  True -> increment#2 (trace "chosen" in 41)
  False -> increment#2 (trace "cold" in error)
--- unoptimized UPLC
(program 1.1.0
  [(lam increment_2
    (case
      (con bool True)
      [increment_2
        (force [[(force (builtin trace)) (con string "cold")] (delay (error))])]
      [increment_2
        (force
          [[(force (builtin trace)) (con string "chosen")] (delay (con integer 41))])]))
    (lam x_1 [[(builtin addInteger) x_1] (con integer 1)])])
--- optimized Core
case@Bool true of
  True -> let anf#5 : int = trace "chosen" in 41 in
  addInteger anf#5 1
  False -> let anf#6 : int = trace "cold" in error in
  addInteger anf#6 1
--- optimized UPLC
(program 1.1.0
  [(lam builtin_3
    (case
      (con bool True)
      [(lam anf_2 [[(builtin addInteger) anf_2] (con integer 1)])
        (force [[builtin_3 (con string "cold")] (delay (error))])]
      [(lam anf_1 [[(builtin addInteger) anf_1] (con integer 1)])
        (force [[builtin_3 (con string "chosen")] (delay (con integer 41))])]))
    (force (builtin trace))])
