        (force [[(force (builtin trace)) (con string "cold")] (delay (error))])]
      [(lam anf_3 [increment_2 anf_3])
        (force
          [[(force (builtin trace)) (con string "chosen")] (delay (con integer 41))])]))
    (lam x_1 [[(builtin addInteger) x_1] (con integer 1)])])
--- core after
