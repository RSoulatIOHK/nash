---
source: crates/nash-codegen/src/optimizer_tests/force_delay.rs
expression: "format!(\"--- core before\\n{}\\n--- core after\\n{}\\n--- uplc before\\n{}\\n--- uplc after\\n{}\\n--- result\\n{}\\n--- logs\\n{:?}\",\npretty(before), pretty(after), left.uplc, right.uplc, right.result,\nright.logs)"
---
--- core before
case@Bool true of
  True -> force (delay (trace "selected" in 42))
  False -> 0
--- core after
case@Bool true of
  True -> trace "selected" in 42
  False -> 0
--- uplc before
(program 1.1.0
  (case
    (con bool True)
    (con integer 0)
    (force
      (delay
        (force
          [[(force (builtin trace)) (con string "selected")] (delay (con integer 42))])))))
--- uplc after
(program 1.1.0
  (case
    (con bool True)
    (con integer 0)
    (force
      [[(force (builtin trace)) (con string "selected")] (delay (con integer 42))])))
--- result
(con integer 42)
--- logs
["selected"]
