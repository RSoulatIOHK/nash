---
source: crates/nash-codegen/src/optimizer_tests/unused_params.rs
expression: "format!(\"--- core before\\n{}\\n--- core after\\n{}\\n--- uplc before\\n{}\\n--- uplc after\\n{}\\n--- result\\n{}\\n--- logs\\n{:?}\",\npretty(before), pretty(after), baseline.uplc, candidate.uplc,\ncandidate.result, candidate.logs)"
---
--- core before
let helper#3 : int -> int -> int = \unused#1 : int used#2 : int -> trace "body" in used#2 in
let anf#5 : int = trace "argument" in error in
helper#3 anf#5 42
--- core after
let helper#3 : int -> int = \used#2 : int -> trace "body" in used#2 in
let anf#5 : int = trace "argument" in error in
helper#3 42
--- uplc before
(program 1.1.0
  [(lam helper_3
    [(lam anf_5 [[helper_3 anf_5] (con integer 42)])
      (force [[(force (builtin trace)) (con string "argument")] (delay (error))])])
    (lam unused_1
      (lam used_2
        (force [[(force (builtin trace)) (con string "body")] (delay used_2)])))])
--- uplc after
(program 1.1.0
  [(lam helper_3
    [(lam anf_5 [helper_3 (con integer 42)])
      (force [[(force (builtin trace)) (con string "argument")] (delay (error))])])
    (lam used_2
      (force [[(force (builtin trace)) (con string "body")] (delay used_2)]))])
--- result
error: ExplicitErrorTerm
--- logs
["argument"]
