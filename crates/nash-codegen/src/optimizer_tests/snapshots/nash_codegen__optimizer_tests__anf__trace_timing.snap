--- core before static lifting
trace (trace "message evaluation" in "outer") in trace "body" in error
--- core after static lifting / before ANF
trace (trace "message evaluation" in "outer") in trace "body" in error
--- core after ANF
let anf#1 : string = trace "message evaluation" in "outer" in
trace anf#1 in trace "body" in error
--- rewritten core (no second ANF)
let anf#2 : string = trace "message evaluation" in "outer" in
trace anf#2 in trace "body" in error
--- baseline
--- uplc
(program 1.1.0
  (force
    [[(force (builtin trace))
      (force
        [[(force (builtin trace)) (con string "message evaluation")]
          (delay (con string "outer"))])]
      (delay (force [[(force (builtin trace)) (con string "body")] (delay (error))]))]))
