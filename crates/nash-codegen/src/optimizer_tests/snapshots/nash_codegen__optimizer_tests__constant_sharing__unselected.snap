---
--- uplc before
(case
  (con bool True)
  [[(builtin addInteger)
    [[(builtin divideInteger) (con integer 10)] (con integer 0)]]
    [[(builtin divideInteger) (con integer 10)] (con integer 0)]]
  (con integer 42))
--- uplc after
[(lam partial_1
  (case
    (con bool True)
    [[(builtin addInteger) [partial_1 (con integer 0)]] [partial_1 (con integer 0)]]
    (con integer 42)))
  [(builtin divideInteger) (con integer 10)]]
