source: crates/nash-codegen/src/anf_tests.rs
assertion_line: 74
expression: "format!(\"--- core before static lifting\\n{}\\n--- core after static lifting / before ANF\\n{}\\n--- core after ANF\\n{}\\n--- rewritten core (no second ANF)\\n{}\\n--- baseline\\n{}\\n--- candidate\\n{}\",\npretty(fresh), pretty(lifted), pretty(first_anf), pretty(after),\nsemantic_output(&baseline), semantic_output(&normalized),)"
---
--- core before static lifting
divideInteger (trace "numerator" in 1) 0 (trace "unreachable" in 2)
--- core after static lifting / before ANF
divideInteger (trace "numerator" in 1) 0 (trace "unreachable" in 2)
--- core after ANF
let anf#1 : int = trace "numerator" in 1 in
let anf#2 : int = divideInteger anf#1 0 in
let anf#3 : int = trace "unreachable" in 2 in
anf#2 anf#3
--- rewritten core (no second ANF)
let anf#4 : int = trace "numerator" in 1 in
let anf#5 : int = divideInteger anf#4 0 in
let anf#6 : int = trace "unreachable" in 2 in
anf#5 anf#6
--- baseline
--- uplc
(program 1.1.0
  [[[(builtin divideInteger)
    (force
      [[(force (builtin trace)) (con string "numerator")] (delay (con integer 1))])]
    (con integer 0)]
    (force
      [[(force (builtin trace)) (con string "unreachable")] (delay (con integer 2))])])
--- result
error: Runtime(DivisionByZero(1, 0))
--- logs
["numerator"]
--- candidate
--- uplc
(program 1.1.0
  [(lam anf_4
    [(lam anf_5
      [(lam anf_6 [anf_5 anf_6])
        (force
          [[(force (builtin trace)) (con string "unreachable")] (delay (con integer 2))])])
      [[(builtin divideInteger) anf_4] (con integer 0)]])
    (force
      [[(force (builtin trace)) (con string "numerator")] (delay (con integer 1))])])
--- result
error: Runtime(DivisionByZero(1, 0))
