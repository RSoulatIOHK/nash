    False -> countdown#1 (trace "step" in subtractInteger n#2 1)
in
countdown#1 2
--- core after
let countdown#14 : int -> int = (\self#9 : @self (int -> int) -> self#9 self#9) (\self#10 : @self (int -> int) n#11 : int -> let anf#12 : bool = equalsInteger n#11 0 in
case@Bool anf#12 of
  True -> 42
  False -> let anf#13 : int = trace "step" in subtractInteger n#11 1 in
  self#10 self#10 anf#13) in
countdown#14 2
