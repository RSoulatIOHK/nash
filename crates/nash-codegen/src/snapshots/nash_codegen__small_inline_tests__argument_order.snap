---
source: crates/nash-codegen/src/small_inline_tests.rs
expression: "format!(\"--- core before\\n{}\\n--- core after\\n{}\\n--- baseline uplc\\n{}\\n--- optimized uplc\\n{}\\n--- result\\n{}\\n--- logs\\n{:?}\",\npretty(before), pretty(after), baseline.uplc, candidate.uplc,\ncandidate.result, candidate.logs)"
---
--- core before
let subtract#3 : int -> int -> int = \x#1 : int y#2 : int -> subtractInteger y#2 x#1 in
let twice#4 : int -> int = \x#5 : int -> addInteger x#5 x#5 in
let anf#6 : int = trace "first" in 2 in
let anf#7 : int -> int = subtract#3 anf#6 in
let anf#8 : int = trace "second" in 5 in
let anf#9 : int = anf#7 anf#8 in
let anf#10 : int = subtract#3 1 4 in
let anf#11 : int = trace "once" in 10 in
let anf#12 : int = twice#4 anf#11 in
let anf#13 : int = twice#4 11 in
let anf#14 : int = addInteger anf#12 anf#13 in
let anf#15 : int = addInteger anf#10 anf#14 in
addInteger anf#9 anf#15
--- core after
let anf#6 : int = trace "first" in 2 in
let anf#8 : int = trace "second" in 5 in
let anf#9 : int = subtractInteger anf#8 anf#6 in
let anf#10 : int = subtractInteger 4 1 in
let anf#11 : int = trace "once" in 10 in
let anf#12 : int = addInteger anf#11 anf#11 in
let anf#13 : int = addInteger 11 11 in
let anf#14 : int = addInteger anf#12 anf#13 in
let anf#15 : int = addInteger anf#10 anf#14 in
addInteger anf#9 anf#15
--- baseline uplc
(program 1.1.0
  [(lam subtract_3
    [(lam twice_4
      [(lam anf_6
        [(lam anf_7
          [(lam anf_8
            [(lam anf_9
              [(lam anf_10
                [(lam anf_11
                  [(lam anf_12
                    [(lam anf_13
                      [(lam anf_14
                        [(lam anf_15 [[(builtin addInteger) anf_9] anf_15])
                          [[(builtin addInteger) anf_10] anf_14]])
                        [[(builtin addInteger) anf_12] anf_13]])
                      [twice_4 (con integer 11)]])
                    [twice_4 anf_11]])
                  (force [[(force (builtin trace)) (con string "once")] (delay (con integer 10))])])
                [[subtract_3 (con integer 1)] (con integer 4)]])
              [anf_7 anf_8]])
            (force
              [[(force (builtin trace)) (con string "second")] (delay (con integer 5))])])
          [subtract_3 anf_6]])
        (force [[(force (builtin trace)) (con string "first")] (delay (con integer 2))])])
      (lam x_5 [[(builtin addInteger) x_5] x_5])])
    (lam x_1 (lam y_2 [[(builtin subtractInteger) y_2] x_1]))])
--- optimized uplc
(program 1.1.0
  [(lam anf_6
    [(lam anf_8
      [(lam anf_9
        [(lam anf_10
          [(lam anf_11
            [(lam anf_12
              [(lam anf_13
                [(lam anf_14
                  [(lam anf_15 [[(builtin addInteger) anf_9] anf_15])
                    [[(builtin addInteger) anf_10] anf_14]])
                  [[(builtin addInteger) anf_12] anf_13]])
                [[(builtin addInteger) (con integer 11)] (con integer 11)]])
              [[(builtin addInteger) anf_11] anf_11]])
            (force [[(force (builtin trace)) (con string "once")] (delay (con integer 10))])])
          [[(builtin subtractInteger) (con integer 4)] (con integer 1)]])
        [[(builtin subtractInteger) anf_8] anf_6]])
      (force
        [[(force (builtin trace)) (con string "second")] (delay (con integer 5))])])
    (force [[(force (builtin trace)) (con string "first")] (delay (con integer 2))])])
--- result
(con integer 48)
--- logs
["first", "second", "once"]
