module Map exposing
    ( empty
    , singleton
    , insert
    , get
    , remove
    , keys
    , values
    , toList
    , foldl
    , union
    )


import Builtin
import Function exposing ( (|>) )
import Primitive exposing ( Big, type bool(..) )
import Lift exposing ( Lift )
import Eq exposing ( Eq )
import List
import Option exposing ( type option(..) )
import Pair
import Functor


{-| Remove left entries whose keys occur on the right, then append the right entries. Other ordering and duplicates are preserved. -}
union : ( Eq 'k, Lift (map 'k 'v) 'a, Lift (map 'k 'v) 'b )
    => 'a -> 'b -> map 'k 'v
union left right = unionList (lower left) (lower right)


unionList : Eq 'k => map 'k 'v -> map 'k 'v -> map 'k 'v
unionList left right = List.append (asList (withoutRightKeys left right)) (asList right)


withoutRightKeys : Eq 'k
    => map 'k 'v -> map 'k 'v -> map 'k 'v
withoutRightKeys left right =
    case left of
        [] ->
            []

        entry :: rest ->
            let
                pair(key, _) = entry
            in
                if containsKey key right then
                    withoutRightKeys rest right
                else
                    Builtin.mkCons entry (withoutRightKeys rest right)


containsKey : Eq 'k => 'k -> map 'k 'v -> bool
containsKey key entries =
    case entries of
        [] ->
            False

        pair(entryKey, _) :: rest ->
            if eq key entryKey then
                True
            else
                containsKey key rest


{-| An empty native map list. -}
empty : map 'k 'v
empty = []


{-| Construct one entry from Big key and value components. -}
singleton : ('k : Big) -> ('v : Big) -> map 'k 'v
singleton key value = [ Builtin.mkPairData key value ]


{-| Remove all entries with the key, then append the new Big key/value pair. -}
insert : ( Eq 'k, Lift (map 'k 'v) 'm )
    => ('k : Big) -> ('v : Big) -> 'm -> map 'k 'v
insert key value entries =
    List.append (asList (remove key entries)) (asList (singleton key value))


{-| Return the value of the first matching key, or None. -}
get : ( Eq 'k, Lift (map 'k 'v) 'm ) => 'k -> 'm -> option 'v
get key entries = getList key (lower entries)


getList : Eq 'k => 'k -> map 'k 'v -> option 'v
getList key entries =
    case entries of
        [] ->
            None

        pair(k, v) :: rest ->
            if eq key k then
                Some v
            else
                getList key rest


{-| Remove all entries with a matching key. -}
remove : ( Eq 'k, Lift (map 'k 'v) 'm ) => 'k -> 'm -> map 'k 'v
remove key entries =
    List.filter
        (
            \entry ->
                let
                    pair(k, _) = entry
                in
                    neq key k
        )
        (toList entries)


{-| Return keys in entry order, preserving their representations. -}
keys : Lift (map 'k 'v) 'input => 'input -> list 'k
keys entries =
    entries
        |> toList
        |> Functor.map Pair.fst


{-| Return values in entry order, preserving their representations. -}
values : Lift (map 'k 'v) 'input => 'input -> list 'v
values entries =
    entries
        |> toList
        |> Functor.map Pair.snd


{-| Lower the outer map to its native pair list without converting keys or values. -}
toList : Lift (map 'k 'v) 'm => 'm -> list (pair 'k 'v)
toList entries = asList (lower entries)


asList : map 'k 'v -> list (pair 'k 'v)
asList entries = entries


{-| Fold entries left to right, passing key, value, then accumulator. -}
foldl : Lift (map 'k 'v) 'm => ('k -> 'v -> 'b -> 'b) -> 'b -> 'm -> 'b
foldl f initial entries =
    List.foldl
        (
            \entry acc ->
                let
                    pair(k, v) = entry
                in
                    f k v acc
        )
        initial
        (toList entries)
